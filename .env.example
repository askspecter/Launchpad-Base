# ─────────────────────────────────────────────────────────────
# Pork — cinematic AI launchpad. Environment variables.
# Copy to .env.local and fill in. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# --- AI generation (server-side only) ---
# Pork turns one sentence into a full launch package via an LLM.
# Provider: "bankr" (default) or "anthropic". Auto-detects from whichever key
# is set; force it with AI_PROVIDER.
AI_PROVIDER=bankr

# Bankr LLM Gateway (default). Create a key with "LLM Gateway" enabled at
# https://bankr.bot/api-keys and top up credits. Routes to Claude/GPT/Gemini.
BANKR_API_KEY=
BANKR_MODEL=claude-sonnet-5
# BANKR_BASE_URL=https://llm.bankr.bot   # override only if needed

# Anthropic direct (optional fallback).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- AI image generation (logo + photo) ---
# Pork can generate real token art in two styles: "icon" (a clean logo) and
# "photo" (a photorealistic, cinematic image). Point these at an
# OpenAI-compatible images endpoint (…/v1/images/generations). If unset, the
# icon style falls back to a deterministic SVG so the studio still runs.
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1024   # optional; defaults to 512 (icon) / 1024 (photo)

# --- Image storage (token logo uploads → shown in the feed) ---
# Vercel KV (Storage tab) sets KV_REST_API_URL / KV_REST_API_TOKEN.
# An Upstash Redis marketplace integration sets the UPSTASH_* pair instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Wallet (mobile connect) ---
# WalletConnect Project ID (free at cloud.reown.com). Without it, MetaMask,
# Coinbase Wallet and injected/browser wallets still work; adding it enables the
# WalletConnect QR + more mobile wallets.
NEXT_PUBLIC_WC_PROJECT_ID=

# --- Chain / explorer (public, safe to expose) ---
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# --- Pons contract addresses (verified defaults hardcoded in registry.ts) ---
# Override only if needed.
NEXT_PUBLIC_PONS_V1_FACTORY=
NEXT_PUBLIC_PONS_V2_FACTORY=
# Optional: extra ERC-20 quote assets (RWA pairs) for v2, comma-separated.
# Validated on-chain before being shown. Native ETH is always available.
NEXT_PUBLIC_V2_PAIR_TOKENS=

# --- (Optional) Analytics via Dune ---
# When set, /analytics fills volume / trades / revenue from Dune. Without it,
# those show "—" and only launches + unique devs (indexed from Pork) appear.
# Create a key at dune.com/settings/api, then point each var at a saved query id.
DUNE_API_KEY=
# Query returning ONE row of all-time totals. Recognized columns (any subset):
#   volume_usd, trades, protocol_revenue_usd, creator_earnings_usd,
#   launches, unique_devs
DUNE_QUERY_ALLTIME=
# Same one-row shape but for the latest 24h.
DUNE_QUERY_24H=
# Optional daily series: rows of { day (date), launches } for the launches chart.
DUNE_QUERY_SERIES=
